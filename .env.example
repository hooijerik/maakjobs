# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://maakjobs.nl

# Optional: override the SQLite database path (defaults to ./data/maakjobs.db)
# MAAKJOBS_DB=./data/maakjobs.db

# Email via Resend (https://resend.com/api-keys) for alert digests + employer-submission
# notifications. If RESEND_API_KEY is unset, emails are logged (dry-run) instead of sent.
# RESEND_API_KEY=re_xxxxxxxx
# Sender address on your VERIFIED Resend domain. Use a bare address (no spaces) so it
# loads cleanly in cron/systemd; the "Maakjobs" display name is added automatically.
# ALERTS_FROM_EMAIL=vacatures@maakjobs.nl
# Where employer job submissions are emailed (any address is fine):
# SUBMISSIONS_TO_EMAIL=info@maakjobs.nl

# Admin for premium placements — protects /admin + /api/admin. Set a long random string
# (min. 8 chars); without it the admin is disabled. Generate e.g. `openssl rand -hex 24`.
# ADMIN_TOKEN=

# Optional: USD -> EUR conversion rate used when aggregating non-EUR salaries.
SALARY_USD_EUR_RATE=0.92
